{
  "name": "endfield-balloon-solver",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "pages:deploy": "npx wrangler pages deploy public",
    "test:vision": "node tools/test-vision.mjs",
    "test:vision2": "node tools/test-vision2.mjs",
    "test:vision3": "node tools/test-vision3.mjs",
    "test:solver": "node tools/test-solver.mjs",
    "test:circuit": "node tools/test-circuit.mjs",
    "test:circuit-pre": "node tools/test-circuit-preplaced.mjs",
    "test:circuit-vision": "node tools/test-circuit-vision.mjs",
    "test:circuit-digits": "node tools/test-circuit-digits.mjs",
    "test:circuit-type2": "node tools/test-circuit-type2.mjs",
    "start": "electron .",
    "build:exe": "node tools/build-exe.mjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.yss161.zmdtool",
    "productName": "终末地解密工具",
    "files": [
      "electron/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "zmdtool.exe",
      "unpackDirName": "zmdtool"
    },
    "compression": "maximum"
  },
  "version": "1.0.0",
  "description": "《明日方舟：终末地》解密工具：浮空气球 & 源石电路（截图自动识别 + 求解，纯本地计算）",
  "author": "yss161"
}
